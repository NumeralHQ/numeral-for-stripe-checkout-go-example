# Server-only test credential. Never expose this value to browser code.
NUMERAL_API_KEY=sk_test_replace_me

# Published test-mode configuration from Developers -> Numeral Stripe Checkout.
NUMERAL_STRIPE_CHECKOUT_CONFIG_ID=brcfg_replace_me

# A recurring Stripe Price from the Stripe account connected to the configuration.
STRIPE_RECURRING_PRICE_ID=price_replace_me

# Optional display-only values for the fictional Northstar subscription.
DEMO_PRICE_CENTS=900
DEMO_BILLING_INTERVAL=month

# Local server port.
PORT=3004

# Only enable this behind a trusted reverse proxy that overwrites these headers.
TRUST_PROXY_HEADERS=false

# Optional: only needed when developing Numeral itself.
# NUMERAL_API_BASE_URL=https://api.numeralhq.com
# NUMERAL_CHECKOUT_URL=https://checkout.numeralhq.com
# NUMERAL_CHECKOUT_ELEMENT_URL=https://checkout.numeralhq.com/bridge/v1.js
